# VeriBid Backend – environment template
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/bid_compliance

# CORS – frontend origin
CLIENT_ORIGIN=http://localhost:5173

# JWT secrets – generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_min_32_chars_replace_with_random_secret
JWT_REFRESH_SECRET=change_me_min_32_chars_replace_with_random_secret

# Token lifetimes
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
REFRESH_GRACE_SECONDS=10

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# AI service (Python FastAPI – set AI_SERVICE_TOKEN if you add auth to it)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=90000

# Background job worker poll interval (milliseconds)
WORKER_POLL_MS=2000

# Demo seed password (used by: npm run seed)
SEED_DEMO_PASSWORD=Demo@Procure2026
